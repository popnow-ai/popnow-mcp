{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.popnow-ai/popnow-mcp",
  "title": "PopNow",
  "description": "AI image, video, music and speech generation: text-to-video, image-to-video, effects and upscaling.",
  "websiteUrl": "https://popnow.ai/mcp",
  "icons": [
    {
      "src": "https://popnow.ai/brand/popnow-logo.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/popnow-ai/popnow-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.popnow.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. 'Bearer sk-popnow-...' API key from https://popnow.ai/api/console/keys. Omit it to sign in with OAuth.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@popnow/mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "POPNOW_API_KEY",
          "description": "PopNow API key (sk-popnow-...) from https://popnow.ai/api/console/keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "POPNOW_MCP_URL",
          "description": "Override the remote endpoint (default https://api.popnow.ai/mcp)",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
